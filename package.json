{
  "name": "shellx",
  "version": "0.3.61",
  "description": "Cross-platform desktop shell for agent CLIs and ACP-speaking agents",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "tsx>esbuild": "0.28.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/martinsbrezauckis/shellx.git"
  },
  "homepage": "https://github.com/martinsbrezauckis/shellx#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/public/check-source-size-budget.mjs && vite build --configLoader runner && node scripts/public/check-bundle-budget.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "node scripts/public/run-public-test-suite.mjs",
    "test:public": "node scripts/public/run-public-test-suite.mjs",
    "audit:dependencies": "pnpm audit --audit-level low",
    "audit:rust": "node scripts/public/check-rustsec.mjs && node scripts/public/check-grype-rust.mjs",
    "source:size": "node scripts/public/check-source-size-budget.mjs",
    "vault:provenance:check": "node scripts/public/generate-vault-vendor-provenance.mjs --check",
    "shellx-browser": "tsx scripts/public/shellx-browser-cli.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4",
    "typescript": "^5",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.2.11",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-resizable-panels": "^2.1.9",
    "remark-gfm": "^4.0.1",
    "shiki": "^1.29.2",
    "xterm": "^5.3.0"
  }
}
